# 文档正文与原始文本证据使用普通 Git；媒体附件通过 Git LFS 存储。
*.html -filter text eol=lf
*.json -filter text eol=lf
*.xml -filter text eol=lf
*.csv -filter text eol=lf
*.txt -filter text eol=lf
*.log -filter text eol=lf
*.svg -filter text eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text

# Handoff binary evidence: keep captures/log archives out of ordinary Git.
*.rgba-f32.gz filter=lfs diff=lfs merge=lfs -text
*.log.gz filter=lfs diff=lfs merge=lfs -text
**/generated*.shader filter=lfs diff=lfs merge=lfs -text

